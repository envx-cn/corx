# .env.production.template — example deployment values for CORX.
#
# Copy to `.env.production` and fill in YOUR values. That file is gitignored;
# this template is the committed, value-free version of it, so the repository
# never carries one deployment's hostnames, keys or email addresses.
#
#   cp .env.production.template .env.production
#
# Two ways to use it:
#
#   npx wrangler deploy --secrets-file .env.production   # bootstrap once
#   npx wrangler secret put PROXY_ZONE                    # afterwards, one by one
#
# Plain-text `vars` in wrangler.jsonc are rewritten on every deploy; secrets
# written this way are not (`wrangler secret delete` is the only thing that
# removes them). That is why everything below is a secret even when its value
# is not sensitive — it describes THIS deployment only.
#
# Format: KEY=value, one per line. Lines starting with `#` are ignored. Every
# value below is either base64 (`openssl rand -base64 32`) or a hostname, so
# none of them need quoting; add quotes only for a value with spaces or a `#`.
# After a `--secrets-file` run, `npx wrangler secret list` shows what landed.


# --- Deployment identifiers ----------------------------------------------

# Subdomain mode suffix: `example.corx.com` -> target `example.com`.
# Empty/absent = auto-detect from the request Host, which works at any zone
# depth but decodes `corx.example.com` as the target `corx.com`. Set it when
# the worker is reachable at a custom hostname.
# PROXY_ZONE=corx.example.com


# --- Admin access ---------------------------------------------------------

# Bearer token for /api/* and the fallback console login. Generate, then keep
# it in a password manager:
#   openssl rand -base64 32
# ADMIN_TOKEN=

# HMAC key for console session cookies. Optional — falls back to ADMIN_TOKEN,
# which couples the two (rotating the token logs everyone out). Set it to
# decouple them.
# SESSION_SECRET=

# Cloudflare Access (Zero Trust) in front of /console + /api. The team domain
# and the AUD tag are one unit: Access login stays off unless BOTH are set.
# Prefer Access over the shared token once the console is on a public host.
# Get the AUD from Access -> Applications -> your app -> Overview.
# ACCESS_TEAM_DOMAIN=https://yourteam.cloudflareaccess.com
# ACCESS_AUD=

# Optional email allowlist, re-checked on every request (removing an address
# invalidates its live session within milliseconds). Empty = any identity the
# Access application admits.
# ADMIN_EMAILS=you@example.com


# --- Secret injection at rest --------------------------------------------

# Encrypts per-key injected variable values (AES-256-GCM, key derived via
# HKDF). Optional: empty stores them as plaintext, which is a silent downgrade
# — set it before you store any real upstream credential.
#
#   openssl rand -base64 32
#
# Losing it makes existing ciphertext unreadable: injection fails closed
# (requests still work, no secret attached) and edits are refused until the
# values are re-entered. Rotate instead of changing it: `npm run kek:rotate`
# re-wraps every stored value from the old secret to the new one (dry-run
# first), see README → "Rotating INJECTION_KEK" — and back it up with the same
# care as the secrets it protects.
# INJECTION_KEK=


# --- Public tier (optional) ----------------------------------------------

# The shared key for the hosted instance, rendered on the landing page so
# visitors can call the proxy from their own sites. Publicly visible by
# design (D1 stores only its hash) — it is a secret here only to keep one
# deployment's values out of the repository.
#
# Create the key first (`POST /api/keys`, or the console), then paste the raw
# value here and PATCH it to `"tier":"public"` with its daily caps. A public
# key without `dailyLimitTotal` is refused with 503 rather than served
# unmetered.
# PUBLIC_KEY=

# The landing page's injection demo: the raw value of an ordinary key whose
# host allowlist is this deployment and whose rules inject a fake credential
# into the echo endpoint (`/demo/echo`). Without a matching row — or when the
# request host is not the allowlisted one — the demo hides itself instead of
# rendering a button that would 403. Create the key in the console (host
# allowlist = this deployment, the same two rules) or run the seed script
# against the remote DB, then put the raw value here.
# DEMO_KEY=
