/**
 * corx — CORS proxy on Cloudflare
 * Stack: Hono + D1 + R2
 *
 * 1. Create D1 + R2 (once):
 *    npm run db:create        # copy the database_id into wrangler.jsonc
 *    npm run bucket:create
 * 2. Dev:
 *    cp .dev.vars.example .dev.vars   # fill in ADMIN_TOKEN
 *    npm run db:migrate:local
 *    npm run dev
 * 3. Deploy:
 *    npm run db:migrate
 *    npx wrangler secret put ADMIN_TOKEN
 *    npm run deploy
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "corx",
	"main": "./dist/index.js",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat",
		// A Worker's fetch() to a hostname in its own zone is routed to that
		// zone's origin by default. A Workers Custom Domain has no origin (its
		// DNS target is a placeholder), so the injection demo — which proxies to
		// /demo/echo on its own hostname — surfaces that as a 522. This flag
		// makes same-zone subrequests behave like a request from the public
		// internet: they loop back through the front door, so the demo reaches
		// the Worker, and CORX proxying another host in its own zone sees the
		// edge (cache/WAF) instead of bypassing it. *.workers.dev hosts already
		// route publicly; the flag keeps both paths identical.
		"global_fetch_strictly_public"
	],
	"workers_dev": true,
	"assets": {
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		// Only deployment-independent knobs and defaults live here. Everything that
		// describes THIS deployment lives in `wrangler secret put` instead, so the
		// repository never carries one deployment's values (nor anything personal):
		//   PROXY_ZONE, ACCESS_TEAM_DOMAIN, ACCESS_AUD, ADMIN_EMAILS, PUBLIC_KEY
		//   (+ the credentials ADMIN_TOKEN, SESSION_SECRET, INJECTION_KEK)
		// `wrangler deploy` rewrites plain-text vars from this file on every deploy
		// but never touches secrets, so anything kept below must be identical for
		// every deployment of this Worker. See README → Secrets.
		"ALLOWED_ORIGINS": "*",
		"REQUIRE_API_KEY": "true",
		"CACHE_TTL_SECONDS": "3600",
		"PUBLIC_CACHE_TTL_SECONDS": "300",
		"TIMEOUT_MS": "30000",
		"RATE_LIMIT_PER_MIN": "60",
		"MAX_BODY_BYTES": "10485760",
		"LOG_REQUESTS": "true",
		"LOG_RETENTION_DAYS": "30"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "corx-db",
			"database_id": "f507c30b-425b-4986-be56-967f75be6e56",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "CACHE_BUCKET",
			"bucket_name": "corx-cache"
		}
	],
	"triggers": {
		"crons": [
			"0 3 * * *"
		]
	}
}
