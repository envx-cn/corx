{
  "name": "corx",
  "version": "0.1.0",
  "description": "corx — a CORS proxy running on Cloudflare (Hono + D1 + R2)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "rm -rf dist && vite build --mode client && vite build",
    "deploy": "npm run build && wrangler deploy",
    "tail": "wrangler tail",
    "db:create": "wrangler d1 create corx-db",
    "db:migrate": "wrangler d1 migrations apply corx-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply corx-db --local",
    "db:seed:public": "node scripts/seed-public-key.mjs",
    "db:seed:demo": "node scripts/seed-demo-key.mjs",
    "kek:rotate": "node scripts/rotate-kek.mjs",
    "bucket:create": "wrangler r2 bucket create corx-cache",
    "cf-typegen": "wrangler types worker-configuration.d.ts",
    "check": "tsc --noEmit",
    "check:contrast": "node scripts/contrast-check.mjs",
    "og": "node scripts/make-og.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.9.9",
    "honox": "^0.1.61",
    "lucide-static": "^1.43.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/postcss": "^4.3.3",
    "daisyui": "^5.7.32",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "wrangler": "^4.37.0"
  }
}
