# Local dev secrets (never commit). Copy to `.dev.vars`.
#
# In production the whole list below lives in `wrangler secret put` (or a
# --secrets-file), never in `wrangler.jsonc` — the repository stays free of one
# deployment's values. `wrangler deploy` rewrites plain-text `vars` from the
# config file on every deploy, but never touches secrets, so a value kept in
# the config would have to be identical for every deployment.
#
# Local dev still needs them here: `.dev.vars` is loaded as secret bindings for
# `wrangler dev` / vite, and is gitignored.

# --- Credentials ---------------------------------------------------------
# Bearer token for /api/* and the console login. Generate one:
#   openssl rand -base64 32
ADMIN_TOKEN = ""

# Session cookie HMAC secret (optional — falls back to ADMIN_TOKEN).
# SESSION_SECRET = "dev-session-secret-change-me"

# Encrypts injected variable values at rest (optional; empty = plaintext).
# Any long random string. Rotate it with `npm run kek:rotate` (README →
# "Rotating INJECTION_KEK") — changing it without re-wrapping makes stored
# secrets unreadable, so back it up with the same care as the values themselves.
# INJECTION_KEK = "dev-injection-kek-change-me"

# --- Deployment values (secrets in production) ---------------------------
# Subdomain mode suffix (`example.corx.com` → `example.com`).
# Empty = auto-detect from the request Host (works at any zone depth).
# PROXY_ZONE = "corx.example.com"

# Public tier: the shared key users embed on their own sites. The raw value is
# rendered on the landing page and D1 stores only its hash, so it is public by
# design — it lives in a secret only to keep deployment values out of the repo.
# For local dev: set it here, then run `npm run db:seed:public` once so the
# landing page has a matching public-tier row.
# PUBLIC_KEY = "corx_dev_public_key"

# Injection demo ("the browser never gets the upstream credential", shown as a
# live run on the landing page). The raw value of a key whose host allowlist is
# this deployment and whose rules inject a fake secret into the echo endpoint
# (/demo/echo). Set it here, then run `npm run db:seed:demo -- --host <this host>`
# once; without a matching row — or when the request host is not the allowlisted
# one — the demo hides itself instead of rendering a button that would 403.
# See README -> "See secret injection work".
# DEMO_KEY = "corx_dev_demo_key"

# Cloudflare Access (Zero Trust) login for /console + /admin.
# Leave empty for local dev (use the token form on /console/login).
# ACCESS_TEAM_DOMAIN, ACCESS_AUD and ADMIN_EMAILS are one unit: Access login
# stays off unless the first two are both set (a half-configured pair logs a
# warning), and ADMIN_EMAILS is the optional allowlist checked per request.
# ACCESS_TEAM_DOMAIN = "https://myteam.cloudflareaccess.com"
# ACCESS_AUD = "paste-application-aud-tag"
# ADMIN_EMAILS = "you@company.com"
